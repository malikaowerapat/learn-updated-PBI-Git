	partition DimDate = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( 'netflix_titles'[date_added] ),   -- วันที่เริ่มต้นใน data
				        MAX ( 'netflix_titles'[date_added] )    -- วันที่สิ้นสุดใน data
				    ),
				    "Year",        YEAR ( [Date] ),
				    "MonthNo",     MONTH ( [Date] ),
				    "MonthName",   FORMAT ( [Date], "MMMM" ),
				    "YearMonth",   FORMAT ( [Date], "YYYY-MM" ),
				    "Quarter",     "Q" & FORMAT ( [Date], "Q" ),
				    "Day",         DAY ( [Date] ),
				    "DayName",     FORMAT ( [Date], "DDD" ),
				    "IsWeekend",   IF ( WEEKDAY ( [Date], 2 ) > 5, 1, 0 )
				)
				
				```

	annotation PBI_Id = 4b44b931cbd546f7a8d1ae9f3a8ff0dd

